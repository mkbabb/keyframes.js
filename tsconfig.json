{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "ES2023", "DOM"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "isolatedModules": true,
        "useDefineForClassFields": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "paths": {
            "@src/*": ["./src/*"],
            // L.W8 S1 ED-3 DOGFOOD INVERSION — the TYPE-resolution twin of the
            // vite self-alias (`@mkbabb/keyframes.js` → src/animation/index.ts).
            // The demo flips its kf imports to the published barrel SPECIFIER;
            // without this path, TS resolves those types to dist/keyframes.d.ts
            // (the built roll-up) while the runtime + `loadAnimationEngine()`
            // values resolve to SOURCE via the vite alias — two nominal type
            // identities for the SAME class (the `_compiler` private-field
            // mismatch). Pinning the barrel specifier to source here makes TS and
            // the bundler agree on ONE realm in dev. tsconfig.lib.json inherits
            // this but only includes src/ (which never imports the barrel), so the
            // publishable-surface check is unaffected — it still resolves the real
            // package. Mirrors @src; NOT a removal of the self-alias.
            "@mkbabb/keyframes.js": ["./src/animation/index.ts"],
            "@styles/*": ["./demo/styles/*"],
            // S.D2 — the demo state layer hoisted out of animation-controls/stores/
            // to a first-class @/ peer (a24 F2). Needs BOTH the bare entry (the
            // barrel import `from "@state"`) AND the wildcard (subpath imports
            // `from "@state/sceneMachine"`) — the wildcard alone leaves the bare
            // barrel at TS2307 (P2-1 F7).
            "@state": ["./demo/state/index.ts"],
            "@state/*": ["./demo/state/*"],
            "@components/*": ["./demo/components/*"],
            "@utils/*": ["./demo/utils/*"],
            "@composables/*": ["./demo/composables/*"],
            "@app/*": ["./demo/app/*"],
            "@assets/*": ["./assets/*"]
        }
    },
    "include": ["src/", "demo/"]
}
