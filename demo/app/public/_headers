# keyframes.babb.dev response headers (Cloudflare Pages copies `public/` to the
# build root verbatim).
#
# The embed entry (`/embed/#/cube`; demo/app/embed/): one slice of the demo,
# framed by an allow-listed host. `frame-ancestors` names that host; the policy
# is the slice's own resource graph (bundled scripts, styles and fonts, data:
# glass fonts). `no-transform` keeps the edge from injecting anything into the
# slice.
/embed/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors https://daraksha.babb.dev
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
