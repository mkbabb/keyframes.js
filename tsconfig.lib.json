{
    // Library-scoped type-check. `check:lib` (the CI gate) runs this so a
    // clean runner type-checks ONLY the publishable surface (`src/`) — never
    // the demo, whose later consumer commit imports registry Glass. The
    // whole-project `check` (tsconfig.json, `src/` + `demo/`) stays for demo
    // development after that dependency is restored.
    //
    // A inv β — the library build is glass-ui-free; the type-check that gates
    // the release path must be glass-ui-free too.
    "extends": "./tsconfig.json",
    "include": ["src/"]
}
