// ============================================================================
// CSS @keyframes — Structural Grammar
// Spec: https://www.w3.org/TR/css-animations-1/
//       https://www.w3.org/TR/css-values-4/#calc-syntax
//
// Covers @keyframes rules, keyframe selectors, declaration blocks,
// animation shorthand properties, and CSS class syntax used by
// keyframes.js's parseCSSAnimationKeyframes(). Hand-written combinators
// in keyframes.ts remain the production parsers.
//
// Preprocessing (applied before parsing):
//   1. CSS comments   /* ... */  are stripped
//   2. !important     declarations are stripped (per CSS Animations §3:
//                     "!important" in @keyframes is ignored)
// ============================================================================

// --- Primitives ---

number     = /[-+]?(\d+)?(\.\d+)?([eE][-+]?\d+)?/ ;
integer    = /[-+]?\d+/ ;
ident      = /[a-zA-Z_-][a-zA-Z0-9_-]*/ ;
string     = /"[^"]*"/ | /'[^']*'/ ;

// --- CSS comments (stripped in preprocessing, not parsed) ---
// comment = "/*" , /[\s\S]*?/ , "*/" ;

// --- CSS value tokens (simplified; full value grammar in css-values.bbnf) ---

percentage    = number , "%" ;
dimension     = number , ident ;
hash          = /#[a-zA-Z0-9_-]+/ ;
functionCall  = ident , "(" , functionArgs , ")" ;
functionArgs  = (functionArg , ","?)* ;
functionArg   = functionCall | string | percentage | dimension | hash | number | ident ;

// --- Keyframe selectors (CSS Animations Level 1 §3) ---

fromToKeyword  = "from" | "to" ;
timeValue      = number , ("ms" | "s") ;
selectorValue  = timeValue | percentage | fromToKeyword | number ;
keyframeSelector = selectorValue , ("," , selectorValue)* ;

// --- Declarations ---
//
// The trailing semicolon is optional on the last declaration in a block
// (valid CSS per https://www.w3.org/TR/css-syntax-3/#consume-a-list-of-declarations).
// !important annotations are stripped in preprocessing and never reach the parser.

propertyName  = ident ;
propertyValue = functionCall | string | percentage | dimension | hash | number | ident ;
declaration   = propertyName , ":" , propertyValue+ , ";"? ;
declarationList = declaration+ ;

// --- Per-keyframe timing function ---
//
// CSS Animations Level 1 §3: "animation-timing-function" declared inside a
// keyframe block sets the timing function for that segment. The parser
// extracts and resolves it via getTimingFunction(), then passes it to
// addFrame() as the segment's easing. The property is deleted from the
// frame vars before interpolation.
//
// keyframeTimingFunction = "animation-timing-function" , ":" , timingFunction , ";"? ;

// --- Keyframe blocks ---

keyframeBlock  = keyframeSelector , "{" , declarationList , "}" ;
keyframeBlocks = keyframeBlock+ ;

// --- @keyframes rule (CSS Animations Level 1 §7) ---

vendorPrefix   = /-\w+-/ ;
keyframesName  = ident | string ;
keyframesRule  = vendorPrefix? , "@keyframes" , keyframesName , "{" , keyframeBlocks , "}" ;

// --- Animation shorthand properties (CSS Animations Level 1 §2) ---
// animation: <name> <duration> <timing-function> <delay>
//            <iteration-count> <direction> <fill-mode> <play-state>

timingFunctionKeyword = "ease" | "ease-in" | "ease-out" | "ease-in-out" | "linear" | "step-start" | "step-end" ;
cubicBezier           = "cubic-bezier" , "(" , number , "," , number , "," , number , "," , number , ")" ;
stepsFunction         = "steps" , "(" , integer , ("," , ("start" | "end" | "jump-start"
                        | "jump-end" | "jump-none" | "jump-both"))? , ")" ;
timingFunction        = cubicBezier | stepsFunction | timingFunctionKeyword ;

iterationCount = "infinite" | number ;
direction      = "normal" | "reverse" | "alternate" | "alternate-reverse" ;
fillMode       = "none" | "forwards" | "backwards" | "both" ;
playState      = "running" | "paused" ;

duration       = number , ("ms" | "s") ;
delay          = number , ("ms" | "s") ;

animationShorthand = keyframesName , duration? , timingFunction? , delay?
                   , iterationCount? , direction? , fillMode? , playState? ;

// --- CSS class (keyframes.js extension) ---
// .className { animation-duration: 1s; animation-timing-function: ease; ... }

cssClassSelector = "." , ident ;
cssClass         = cssClassSelector , "{" , declarationList , "}" ;

// --- Full animation input (keyframes.js) ---
// Accepts either a .class + @keyframes combo or bare keyframe blocks

animationValue = cssClass | keyframesRule | keyframeBlocks ;
